{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sharezynho",
  "version": "0.1.2",
  "identifier": "com.sharezynho.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sharezynho",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#100f0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RkY2MDNCMUU5REYzOUMKUldTYzg1MGVPMkQvbG5ycXhpcXpUUU5SY1Jrc2plVk1wMTRkZ2crSElLWlZvclVMQ1ZyNTN5bGIK",
      "endpoints": [
        "https://github.com/starzynhobr/sharezynho2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
