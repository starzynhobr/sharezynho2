{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sharezynho",
  "version": "0.1.0",
  "identifier": "com.sharezynho.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sharezynho",
        "width": 1280,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#070c16"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
